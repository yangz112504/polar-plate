{
  "compilerOptions": {
    "strict": true,
    "allowJs": true,
    "noEmit": true,
    "module": "Preserve",
    "moduleResolution": "bundler",
    "target": "ES2022",
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true
  },
  "include": ["src", "tests", "*.ts", "*.mts"]
}
